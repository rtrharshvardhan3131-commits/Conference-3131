# Public site URL, used for links in email and metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to true to print the open slab's price on the homepage. Later slab amounts stay hidden.
# Leave unset, or false, until the committee wants that price on the public fee board.
NEXT_PUBLIC_SHOW_PRICE_ON_HOME=false

# Supabase. Use the publishable key in the browser and the secret key only on the server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional signing secret for the short-lived registration confirmation cookie.
# Falls back to SUPABASE_SECRET_KEY when omitted.
APP_SIGNING_SECRET=

# Razorpay. Leave blank until the district account and webhook are ready.
# NEXT_PUBLIC_RAZORPAY_KEY_ID is the only payment value that may reach the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Gmail app password for rtr.harshvardhan3131@gmail.com.
# Create it in the Google account under Security, then App passwords.
# Registration mail is skipped, and logged, until this is set. Do not commit the password.
GMAIL_APP_PASSWORD=

# Comma-separated emails for scripts/bootstrap-admin.mjs. The users must already exist in Supabase Auth.
BOOTSTRAP_ADMIN_EMAILS=
