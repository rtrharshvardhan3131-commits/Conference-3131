# Public site URL, used for links in email and metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Preferred public origin for Easebuzz surl/furl and absolute redirects.
# Falls back to NEXT_PUBLIC_APP_URL when omitted.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true to print the open slab's price on the homepage. Later slab amounts stay hidden.
# Leave unset, or false, until the committee wants that price on the public fee board.
NEXT_PUBLIC_SHOW_PRICE_ON_HOME=false

# Supabase. Use the publishable key in the browser and the secret key only on the server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional signing secret for the short-lived registration confirmation cookie.
# Falls back to SUPABASE_SECRET_KEY when omitted.
APP_SIGNING_SECRET=

# Easebuzz (primary online payment). Server-only. Never expose KEY or SALT to the browser.
# Use test keys with EASEBUZZ_ENV=test until KYC and live settlement are ready.
EASEBUZZ_KEY=
EASEBUZZ_SALT=
EASEBUZZ_ENV=test

# Protects /api/cron/easebuzz-reconcile (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=

# Razorpay scaffold. Leave blank unless that path is deliberately re-enabled.
# NEXT_PUBLIC_RAZORPAY_KEY_ID is the only Razorpay value that may reach the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Gmail app password for rtr.harshvardhan3131@gmail.com.
# Create it in the Google account under Security, then App passwords.
# Registration mail is skipped, and logged, until this is set. Do not commit the password.
GMAIL_APP_PASSWORD=

# Comma-separated emails for scripts/bootstrap-admin.mjs. The users must already exist in Supabase Auth.
BOOTSTRAP_ADMIN_EMAILS=
